# ==============================================================================
# Docker Context Exclusion File (.dockerignore)
# Minimizes context transfer overhead and prevents sensitive secrets leaking into layers
# ==============================================================================

# Dependencies & Build Artefacts
node_modules
.next
out
dist
build

# Version Control
.git
.github
.gitignore
.gitattributes

# Secrets & Environment Files (Strict Protection)
.env
.env.*
!.env.example

# Testing, E2E & Coverage
coverage
test-results
playwright-report
playwright.config.ts
vitest.config.ts
vitest.setup.ts
e2e
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts

# IDE & Editor Configuration
.vscode
.idea
.gemini
*.swp
*.swo

# Logs & Temporary Data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo
.vercel
tsconfig.tsbuildinfo

# Documentation & Markdown Files
*.md
!README.md
